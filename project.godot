; Generated by tools/build_lite.gd. Edit the Pro project, not this.
config_version=5

[application]

config/name="Weather System (Lite) - Demo"
config/description="Free 2D + 3D weather for Godot 4.5+. Six states, both drivers, a look profile and a no-code setup dock."
run/main_scene="res://demo/weather_demo_3d.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")

[autoload]

WeatherManager="*res://addons/weather/weather_manager.gd"

[display]

window/size/viewport_width=1180
window/size/viewport_height=720

[editor_plugins]

enabled=PackedStringArray("res://addons/weather/plugin.cfg")

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
